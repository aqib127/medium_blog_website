import React, { useState, useRef, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import '../styles/chatbot.css';
import { endpoints } from '../config/api';

export default function Chatbot({ onClose }) {
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState('');
  const [loading, setLoading] = useState(false);
  const messagesEndRef = useRef(null);
  const navigate = useNavigate();

  const scrollToBottom = () => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  };
  useEffect(scrollToBottom, [messages]);

  const refreshAccessToken = async () => {
    const refresh = localStorage.getItem('refresh');
    if (!refresh) throw new Error('No refresh token');
    const res = await fetch(endpoints.refresh, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refresh }),
    });
    if (!res.ok) {
      localStorage.removeItem('access');
      localStorage.removeItem('refresh');
      throw new Error('Refresh failed – please log in again.');
    }
    const data = await res.json();
    localStorage.setItem('access', data.access);
    if (data.refresh) {
      localStorage.setItem('refresh', data.refresh);
    }
    return data.access;
  };

  const sendMessage = async (e) => {
    e.preventDefault();
    if (!input.trim()) return;

    const userMessage = { role: 'user', content: input };
    setMessages((prev) => [...prev, userMessage]);
    setInput('');
    setLoading(true);

    try {
      let token = localStorage.getItem('access');
      if (!token) throw new Error('No access token');

      // Build history (last 10 messages, exclude current)
      const history = messages
        .slice(-10)
        .filter((m) => m.role === 'user' || m.role === 'assistant')
        .map((m) => ({ role: m.role, content: m.content }));

      let response = await fetch(endpoints.chatbotActions, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({ message: input, history }),
      });

      // Handle token refresh
      if (response.status === 401) {
        try {
          token = await refreshAccessToken();
          response = await fetch(endpoints.chatbotActions, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ message: input, history }),
          });
        } catch (refreshError) {
          throw new Error(refreshError.message);
        }
      }

      if (!response.ok) {
        const text = await response.text();
        throw new Error(`HTTP ${response.status}: ${text}`);
      }

      const data = await response.json();

      // Append assistant message with optional action info
      setMessages((prev) => [
        ...prev,
        {
          role: 'assistant',
          content: data.reply || '(no response)',
          action: data.action || null,
        },
      ]);
    } catch (error) {
      console.error('Chatbot error:', error);
      setMessages((prev) => [
        ...prev,
        {
          role: 'assistant',
          content: error.message || 'Sorry, an error occurred.',
        },
      ]);
    } finally {
      setLoading(false);
    }
  };

  // ---------------------------------------------------------------
  // Action Renderer — shows what the chatbot did
  // ---------------------------------------------------------------
  const renderAction = (action) => {
    if (!action || !action.executed || action.executed.length === 0) return null;

    return (
      <div className="chatbot-action-block">
        {action.executed.map((exec, idx) => {
          const { tool, result } = exec;
          const ok = result?.success;

          return (
            <div
              key={idx}
              className={`chatbot-action-item ${ok ? 'success' : 'error'}`}
            >
              {/* Publish Article */}
              {tool === 'publish_article' && ok && (
                <div>
                  📝 <strong>Article published:</strong>{' '}
                  <a
                    href={`/article/${result.article_id}`}
                    onClick={(e) => {
                      e.preventDefault();
                      onClose?.();
                      navigate(`/article/${result.article_id}`);
                    }}
                    className="chatbot-action-link"
                  >
                    {result.title}
                  </a>
                </div>
              )}

              {/* Clap */}
              {tool === 'clap_article' && ok && (
                <div>
                  👏 <strong>Clapped:</strong> {result.title}{' '}
                  <span className="chatbot-action-meta">
                    ({result.claps_count} claps)
                  </span>
                </div>
              )}

              {/* Unclap */}
              {tool === 'unclap_article' && ok && (
                <div>
                  👏 <strong>Clap removed:</strong> {result.title}
                </div>
              )}

              {/* Follow */}
              {tool === 'follow_user' && ok && (
                <div>
                  👥 <strong>Now following:</strong>{' '}
                  <a
                    href={`/@${result.handle}`}
                    onClick={(e) => {
                      e.preventDefault();
                      onClose?.();
                      navigate(`/@${result.handle}`);
                    }}
                    className="chatbot-action-link"
                  >
                    @{result.handle}
                  </a>
                </div>
              )}

              {/* Unfollow */}
              {tool === 'unfollow_user' && ok && (
                <div>
                  👥 <strong>Unfollowed:</strong> @{result.handle}
                </div>
              )}

              {/* Bookmark */}
              {tool === 'bookmark_article' && ok && (
                <div>
                  🔖 <strong>Bookmarked:</strong> {result.title}
                </div>
              )}

              {/* Search */}
              {tool === 'search_articles' && ok && (
                <div>
                  🔍 <strong>Found {result.count} article(s)</strong>
                  {result.results && result.results.length > 0 && (
                    <ul className="chatbot-action-list">
                      {result.results.slice(0, 5).map((art) => (
                        <li key={art.id}>
                          <a
                            href={`/article/${art.id}`}
                            onClick={(e) => {
                              e.preventDefault();
                              onClose?.();
                              navigate(`/article/${art.id}`);
                            }}
                            className="chatbot-action-link"
                          >
                            {art.title}
                          </a>{' '}
                          <span className="chatbot-action-meta">
                            by @{art.author_handle}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              )}

              {/* Error fallback */}
              {!ok && (
                <div>
                  ⚠️ <strong>Action failed:</strong>{' '}
                  {result?.error || 'Unknown error'}
                </div>
              )}
            </div>
          );
        })}
      </div>
    );
  };

  return (
    <div className="chatbot-window">
      <div className="chatbot-header">
        <span>AI Assistant</span>
        <button className="chatbot-close-btn" onClick={onClose}>
          ×
        </button>
      </div>

      <div className="chatbot-messages">
        {messages.length === 0 && (
          <div className="chatbot-welcome">
            <p>
              Hi! I can help you find articles <em>and</em> perform actions:
            </p>
            <ul className="chatbot-examples">
              <li>&quot;Publish an article titled Hello World&quot;</li>
              <li>&quot;Clap for article 5&quot;</li>
              <li>&quot;Follow @aqib&quot;</li>
              <li>&quot;Bookmark article 12&quot;</li>
              <li>&quot;Search articles about Python&quot;</li>
            </ul>
          </div>
        )}

        {messages.map((msg, idx) => (
          <div key={idx} className={`chatbot-message ${msg.role}`}>
            <div className="message-content">{msg.content}</div>
            {msg.role === 'assistant' && renderAction(msg.action)}
          </div>
        ))}

        {loading && (
          <div className="chatbot-message assistant">
            <div className="message-content">Thinking...</div>
          </div>
        )}

        <div ref={messagesEndRef} />
      </div>

      <form className="chatbot-input-form" onSubmit={sendMessage}>
        <input
          type="text"
          value={input}
          onChange={(e) => setInput(e.target.value)}
          placeholder="Ask or say: 'publish an article...'"
          disabled={loading}
        />
        <button type="submit" disabled={loading || !input.trim()}>
          Send
        </button>
      </form>
    </div>
  );
}